# === API Keys ===
# OpenAI: requerida (fallback ASR + traducción default)
OPENAI_API_KEY=sk-...

# Gemini: opcional (activa Setup A — Gemini Pro como ASR principal)
# Conseguir en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter: opcional (activa Setup A — Claude Haiku como traductor + acceso multi-provider)
# Conseguir en: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# HuggingFace: opcional (solo si usas Cohere Transcribe — modelo gated)
# Aceptar términos primero: https://huggingface.co/CohereLabs/cohere-transcribe-03-2026
HF_TOKEN=

# === Idiomas ===
AUTOSUBS_SOURCE_LANG=ja
AUTOSUBS_TARGET_LANG=es

# === Modelos (si se dejan vacíos, se eligen solos según las API keys) ===
# ASR (CER medido sobre TEDxJP-10K, basura sobre gameplay real):
#   - microsoft/mai-transcribe-2  (7.3% CER, 0.8% basura, $0.00167/min
#     = $0.10/hora, oferta de lanzamiento que Microsoft dijo que acaba a fin
#     de 2026; no publico a cuanto sube)
#   - x-ai/grok-stt-1.0           (8.8% CER, 0.8% basura, $0.0017/min)
#   - qwen/qwen3-asr-0.6b         (11.8% CER, 4.7% basura, $0.0002/min)
#   - local-turbo                 (11.8% CER, 4.5% basura, $0, GPU)
AUTOSUBS_WHISPER_MODEL=microsoft/mai-transcribe-2

# Traductor ($ por línea de subtítulo):
#   - anthropic/claude-haiku-5.5  ($0.000036, mejor con el coloquial)
#   - anthropic/claude-haiku-4.5  ($0.00025)
#   - gpt-4.1                     (OpenAI directo, baseline)
#   - deepseek/deepseek-chat      (barato pero errores culturales)
AUTOSUBS_GPT_MODEL=anthropic/claude-haiku-5.5

# === Audio ===
AUTOSUBS_SEGMENT_DURATION=5
AUTOSUBS_VAD_AGGRESSIVENESS=2

# === yt-dlp ===
# Browser para extraer cookies (firefox, chrome, edge, none)
AUTOSUBS_COOKIES_BROWSER=firefox

# === Tips ===
# - Captura audio del sistema:  uv run autosubs --system-audio
# - Recuperar gaps perdidos:    uv run autosubs "URL" --fill-gaps
# - Empezar desde 1h30m:        uv run autosubs "URL" --start-time 1h30m
# - Comparar transcripers:      uv run autosubs "URL" --benchmark --benchmark-no-translate
