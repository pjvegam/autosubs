# === Requerido ===
OPENAI_API_KEY=sk-...

# === Idiomas ===
LIVESUBS_SOURCE_LANG=ja
LIVESUBS_TARGET_LANG=es

# === Modelos ===
LIVESUBS_WHISPER_MODEL=gpt-4o-transcribe
LIVESUBS_GPT_MODEL=gpt-4o-mini

# === Audio ===
LIVESUBS_SEGMENT_DURATION=5

# === Audio del sistema ===
# Usa --system-audio para capturar lo que suena en la PC (loopback WASAPI)
# uv run livesubs --system-audio --source-lang ja --target-lang es
